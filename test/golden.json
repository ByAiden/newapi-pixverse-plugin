        {
          "status": 200,
          "headers": {}
        }
      ],
      "expected": {
        "status": "UNKNOWN",
        "reason": "unrecognized PixVerse status: 42"
      }
    },
    {
      "name": "the reservation follows the published credits",
      "hook": "extractUsage",
      "args": [
        {
          "requestBody": {
            "model": "pixverse-v6",
            "prompt": "a cat",
            "duration": 8,
            "quality": "720p",
            "aspect_ratio": "16:9",
            "generate_audio_switch": false
          },
          "requestHeaders": {
            "Content-Type": "application/json",
            "Accept": ""
          },
          "action": "text_to_video",
          "model": "pixverse-v6",
          "upstreamModel": "v6",
          "baseUrl": "https://app-api.pixverse.ai",
          "apiKey": "test-key",
          "authHeader": "Bearer test-key",
          "upstream": {
            "kind": "vendor"
          },
          "config": {},
          "files": [],
          "publicTaskId": "task_public"
        }
      ],
      "expected": {
        "credits": 72,
        "seconds": 8,
        "resolution": "720p",
        "audio": false,
        "multi_clip": false
      }
    },
    {
      "name": "a finished task settles on the reported credits",
      "hook": "extractUsageOnComplete",
      "args": [
        {
          "taskId": "5001",
          "publicTaskId": "task_public",
          "action": "text_to_video",
          "model": "pixverse-v6",
          "upstreamModel": "pixverse-v6",
          "baseUrl": "https://app-api.pixverse.ai",
          "apiKey": "test-key",
          "authHeader": "Bearer test-key",
          "upstream": {
            "kind": "vendor"
          },
          "config": {},
          "data": {
            "ErrCode": 0,
            "ErrMsg": "success",
            "Resp": {
              "id": 5001,
              "status": 1,
              "url": "https://media.example/v5001.mp4",
              "credits": 40
            }
          },
          "state": null
        },
        {
          "status": "SUCCESS"
        },
        {
          "ErrCode": 0,
          "ErrMsg": "success",
          "Resp": {
            "id": 5001,
            "status": 1,
            "url": "https://media.example/v5001.mp4",
            "credits": 40
          }
        }
      ],
      "expected": {
        "credits": 40
      }
    },
    {
      "name": "a task without reported credits keeps its reservation",
      "hook": "extractUsageOnComplete",
      "args": [
        {
          "taskId": "5001",
          "publicTaskId": "task_public",
          "action": "text_to_video",
          "model": "pixverse-v6",
