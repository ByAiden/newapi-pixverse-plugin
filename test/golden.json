      "expected": null
    },
    {
      "name": "the finished video is the only artifact",
      "hook": "listArtifacts",
      "args": [
        {
          "task_id": "task_public",
          "status": "SUCCESS",
          "action": "text_to_video",
          "data": {
            "ErrCode": 0,
            "ErrMsg": "success",
            "Resp": {
              "id": 5001,
              "status": 1,
              "url": "https://media.example/v5001.mp4",
              "credits": 40
            }
          }
        }
      ],
      "expected": [
        {
          "key": "video",
          "type": "video",
          "mimeType": "video/mp4"
        }
      ]
    },
    {
      "name": "a failed task has no artifact",
      "hook": "listArtifacts",
      "args": [
        {
          "task_id": "task_public",
          "status": "FAILURE",
          "action": "text_to_video",
          "data": {
            "ErrCode": 0,
            "ErrMsg": "success",
            "Resp": {
              "id": 5001,
              "status": 1,
              "url": "https://media.example/v5001.mp4",
              "credits": 40
            }
          }
        }
      ],
      "expected": []
    }
